# Copie este arquivo para .env (`cp .env.example .env`) se quiser customizar valores localmente.
# O Docker Compose já tem defaults funcionais mesmo sem esse passo.

POSTGRES_DB=vitrio
POSTGRES_USER=vitrio
POSTGRES_PASSWORD=vitrio

# Chave de assinatura HS256 do Access token. Valor abaixo é só para desenvolvimento local
# (mesma lógica dos defaults de Postgres acima) — nunca reaproveitar em produção; lá a chave
# real vem de um secret de verdade (ex.: GitHub Actions secrets), nunca commitada.
JWT_SIGNING_KEY=dev-only-signing-key-never-use-in-production-1234567890

# Origens permitidas por CORS, separadas por vírgula. `http://localhost:3000` é onde
# o `vitrio-web` roda em dev (`pnpm dev`) — sem isso, todo `fetch` do navegador local
# pro `/api/v1/**` é bloqueado no preflight, mesmo a API respondendo 200 via curl.
VITRIO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bucket S3 de imagens (spec 003 — upload de asset), leitura pública configurada via
# bucket policy, escrita restrita ao usuário IAM abaixo (política escopada só a este
# bucket). Sem valor de exemplo aqui de propósito — preencha com os seus após seguir o
# wizard de setup; nunca commitar as chaves reais.
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
