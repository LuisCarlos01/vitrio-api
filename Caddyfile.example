# Substitua {PLACEHOLDER} pelo hostname sslip.io real (Elastic IP da instância,
# com hifens no lugar dos pontos) antes de copiar este arquivo para `Caddyfile`
# na instância — ver docs/deployment.md, seção "Configurar HTTPS (Caddy + sslip.io)".
{PLACEHOLDER}.sslip.io {
    reverse_proxy app:8080
}
